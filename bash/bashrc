# Fresh Bash dotfiles — start with: bash --noprofile --rcfile ~/.config/bash/bashrc -i
[[ $- == *i* ]] || return 0
source "$HOME/.config/bash/env"
if [[ -f "$HOME/.config/bash/blesh/out/ble.sh" ]]; then
  source "$HOME/.config/bash/blesh/out/ble.sh" --attach=none
fi
shopt -s checkwinsize autocd cdspell globstar
for part in history aliases functions completions; do
  [[ -f "$HOME/.config/bash/$part" ]] && source "$HOME/.config/bash/$part"
done
# Optional tool initialization
if [[ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]]; then source "$NVM_DIR/nvm.sh"; fi
if command -v pyenv >/dev/null 2>&1; then eval "$(pyenv init - bash)"; fi
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  export SDKMAN_DIR="$HOME/.sdkman"
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init bash)"; fi
if command -v fzf >/dev/null 2>&1; then
  if [[ -n ${BLE_VERSION-} ]]; then
    ble-import -d integration/fzf-completion
    ble-import -d integration/fzf-key-bindings
  else
    eval "$(fzf --bash)"
  fi
fi
source "$HOME/.config/bash/prompt"
[[ -n ${BLE_VERSION-} ]] && ble-attach
